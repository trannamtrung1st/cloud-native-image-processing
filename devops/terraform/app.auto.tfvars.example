# Initial App Configuration seed only — copy to app.auto.tfvars (gitignored).
#   cp app.auto.tfvars.example app.auto.tfvars
# After first apply: edit keys in Azure Portal (App Configuration, label cnip).
# Deploy reads live values via ../scripts/appconfig-to-helm-values.py — not this file.
# CI variable: TERRAFORM_APP_TFVARS. Portal guide: ../README.md#managing-configuration-in-azure-portal

cnip_app_settings = {
  app = {
    aspnetcore_environment           = "Production"
    dotnet_environment               = "Production"
    blob_container_name              = "images"
    eventhub_image_processing_hub    = "image-processing"
    eventhub_image_processing_cg     = "cg1"
    eventhub_ai_description_hub      = "ai-description"
    eventhub_ai_description_cg       = "cg1"
    eventhub_checkpoint_container    = "eh-checkpoints"
    demo_get_by_id_delay_ms          = "2000"
    demo_grayscale_delay_ms          = "5000"
    demo_ai_description_delay_ms     = "2000"
    upload_max_request_body_bytes    = "10485760"
    identity_bearer_token_hours      = "8"
    redis_details_expiration_minutes = "5"
    cors_allowed_origins             = []
  }
  helm = {
    api_replica_count                        = 1
    worker_replica_count                     = 1
    ai_worker_replica_count                  = 1
    frontend_replica_count                   = 1
    application_insights_enabled             = true
    frontend_images_refresh_interval_seconds = "5"
    # Bump in Portal (e.g. "2", "3") then redeploy to restart API/workers after Key Vault changes.
    deployment_reload_trigger                = "1"
  }
}
