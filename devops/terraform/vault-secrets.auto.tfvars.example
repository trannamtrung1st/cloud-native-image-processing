# Initial Key Vault secret seeds only — copy to vault-secrets.auto.tfvars (gitignored).
#   cp vault-secrets.auto.tfvars.example vault-secrets.auto.tfvars
# After first apply: edit secret VALUES in Azure Portal → Key Vault → Secrets.
# Deploy does not read this file; pods get secrets via CSI + workload identity.
# CI secret: TERRAFORM_VAULT_SECRETS_TFVARS. Portal guide: ../README.md#managing-configuration-in-azure-portal

cnip_vault_secrets_init = {
  computer_vision_endpoint = ""
  computer_vision_api_key  = ""
}
